{
  "name": "context-mode-opencode-v2",
  "version": "1.2.0",
  "description": "OpenCode v2 plugin wrapper for context-mode (mksglu/context-mode), adapting its v1-style adapter to the v2 Plugin.define API.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "context-mode",
    "context",
    "token",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aifeifei798/context-mode-opencode-v2"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "index.js",
    "scripts/smoke.mjs",
    "README.md",
    "LICENSE",
    "AGENTS.md"
  ],
  "scripts": {
    "check": "node --check index.js",
    "smoke": "node scripts/smoke.mjs",
    "reload": "node --check index.js && node scripts/smoke.mjs && opencode service restart"
  },
  "dependencies": {
    "context-mode": "^1.0.169",
    "zod": "^3.25.0"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "context-mode": true
  }
}
